{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(xcodebuild build *)",
      "Bash(xcodebuild test *)",
      "Bash(swift format lint *)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git clean:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}
